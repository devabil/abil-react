# ABiL MEDiAS environment variables (NAMES only, never commit real values)
#
# Copy this file to .env.local for development. In production, set these in
# Vercel → Settings → Environment Variables. Only this .env.example is tracked.
# Leave a variable unset to disable the feature that depends on it; the app
# degrades gracefully (a feature that needs a missing key stays off).

# ── Core / storage ──────────────────────────────────────────────────────────
# Vercel Blob (auto-injected when you connect a Blob store to the project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
BLOB_STORE_ID=store_xxx
BLOB_PUBLIC_BASE_URL=https://<your-store-id>.public.blob.vercel-storage.com
BLOB_WEBHOOK_PUBLIC_KEY=
PUBLIC_BASE_URL=https://abil-site.vercel.app
ABIL_PUBLIC_BASE=https://abil-site.vercel.app
SITE_BASE=https://abil-site.vercel.app

# ── Admin / auth ─────────────────────────────────────────────────────────────
# Server-side admin authentication secret
ABIL_ADMIN_AUTH_SECRET=
# Public "coming soon" gate (VITE_* ships in the client bundle, never a real secret)
VITE_COMING_SOON_MODE=0
VITE_COMING_SOON_PASSWORD=

# ── Encryption / secrets at rest ─────────────────────────────────────────────
# Dedicated, random key that encrypts all private vault data at rest.
# LOSING THIS KEY MAKES THE ENCRYPTED DATA UNREADABLE FOREVER. Keep a copy safe.
VAULT_ENC_KEY=
CRM_ENC_KEY=
CRON_SECRET=
# Salt for audit landing-page slugs (fails closed if unset)
AUDIT_SLUG_SALT=

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
ARK_API_KEY=
ARK_BASE=
ARK_VIDEO_MODEL=
ARK_CHARACTER_ASSET=

# ── E-mail (Resend + optional SMTP/Gmail) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
REPLY_NOTIFY_FROM=
REPLY_NOTIFY_TO=
OUTBOUND_FROM_NAME=
COLD_FROM_EMAIL=
COLD_FROM_NAME=
COLD_DOMAINS=
# Outbound send master switch (1 = do not actually send)
ABIL_SEND_HARD_OFF=1
EMAIL_MAX_PER_DRAIN=
EMAIL_PACING_MS=
EMAIL_DEDUPE_TTL_MS=
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_IMAP_HOST=
GMAIL_REFRESH_TOKEN=
ABIL_GMAIL_REFRESH_TOKEN=

# ── Social / platforms ───────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENC_KEY=
META_ADMIN_KEY=
META_TENANT_ID=abil
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SOCIAL_PROVIDER=
SOCIAL_PROVIDER_BASE=
SOCIAL_PROVIDER_KEY=
YOUTUBE_API_KEY=

# ── Google ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
PLACES_TTL_DAYS=

# ── Media / enrichment / prospecting tuning ──────────────────────────────────
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
SERPAPI_KEY=
HUNTER_API_KEY=
RAIOX_WORKER_URL=
RAIOX_WORKER_TOKEN=
PRES_GEN_API_BASE=
ABIL_UPLOAD_DIR=
ABIL_LP_RDV_URL=
AUDIT_TTL_DAYS=
QUEUE_LOCK_TTL_MS=
QUEUE_INFLIGHT_TTL_MS=
DAILY_LEAD_AUDIT_CAP=
LEADAUDIT_MAX_ATTEMPTS=
LEADAUDIT_MAX_CONCURRENT=
LEADAUDIT_MAX_PER_DRAIN=
LEADAUDIT_LP_CONCURRENT=
LEADAUDIT_LP_PER_DRAIN=
LEADAUDIT_CIRCUIT_BREAK=

# ── Client-side (exposed in the bundle, never secret) ────────────────────────
VITE_GA4_ID=
VITE_GA4_PROPERTY_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_ASSET_STORE=
VITE_ASSET_UPLOAD_URL=
